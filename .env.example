# Local/server runtime
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000
DATA_DIR=./.data
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Set to "supabase" only after storage integration is verified.
STORAGE_PROVIDER=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=archive-media

# Preferred match data provider: API-Football supplies fixtures, scores and player ratings.
# Bayern München is team 157; Germany is team 25 in API-Football.
API_FOOTBALL_API_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_TEAM_IDS=157,25
API_FOOTBALL_LOOKBACK_DAYS=365
API_FOOTBALL_LOOKAHEAD_DAYS=180
API_FOOTBALL_RATING_LIMIT=8

# Fallback: football-data.org supplies scores only (no player ratings).
# Bayern München is team 5; Germany is team 759.
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_TEAM_IDS=5,759
FOOTBALL_CRON_SECRET=

# Development-only convenience. Do not enable in a public production deployment.
LOCAL_RESET_LINKS=false
PRIVATE_AUTO_LOGIN=false
